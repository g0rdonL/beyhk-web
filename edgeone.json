{
  "rewrites": [
    { "source": "/i/*", "destination": "/404.html" },
    { "source": "/invite/*", "destination": "/404.html" },
    { "source": "/match/confirm/*", "destination": "/404.html" },
    { "source": "/player/*", "destination": "/404.html" },
    { "source": "/p/*", "destination": "/404.html" }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    },
    {
      "source": "/*",
      "headers": [{ "key": "Strict-Transport-Security", "value": "max-age=31536000" }]
    }
  ]
}
